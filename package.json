{
  "name": "etpark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.js,.jsx,.cjs,.mjs",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{ts,js,vue,scss,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,vue,scss,css}\"",
    "test": "vitest run",
    "type-check": "vue-tsc -b",
    "api": "node --env-file-if-exists=.env.local server/parking.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "proj4": "^2.22.0",
    "vue": "^3.5.42",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.5",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "3.18.0",
    "eslint-plugin-vue": "^9.33.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sass": "^1.105.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
